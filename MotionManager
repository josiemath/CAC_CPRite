import Foundation
import CoreMotion
import Combine

final class MotionManager: ObservableObject {
    
    private let detectorWarmupTime: TimeInterval = 1.0
    
    private let motionManager = CMMotionManager()

    private var firstTimestamp: TimeInterval?

    private var zFilter = SignalFilter(windowSize: 5)

    // TEMPORARY calibration values.
    // We will adjust these after testing on the real iPhone + manikin.
    private var compressionDetector = CompressionDetector(
        threshold: 0.25,
        releaseThreshold: -0.15,
        minimumInterval: 0.30
    )
    
    private var rateEstimator = RateEstimator()
    
    private var cprCoach: CPRCoach
    
    private let maximumSamples = 500
    
    private var sessionCompressionTimes: [TimeInterval] = []

    @Published var currentCPM: Double?
    
    @Published var accelerationX: Double = 0
    @Published var accelerationY: Double = 0
    @Published var accelerationZ: Double = 0

    @Published var filteredZ: Double = 0

    @Published var timestamp: TimeInterval = 0

    @Published var isRunning = false

    @Published var errorMessage: String?

    @Published var samples: [MotionSample] = []

    @Published var compressionCount = 0
    
    @Published var rotationMagnitude: Double = 0
    
    @Published var maxRotationMagnitude: Double = 0
    
    @Published var compressionsInCycle = 0

    @Published var compressionCycleTarget = 30

    @Published var breathsDue = false

    @Published var breathTarget = 2

    @Published var completedCycles = 0

    @Published var switchRescuerDue = false
    
    @Published private(set) var sessionAverageCPM: Double?
    
    func acknowledgeRescuerSwitch() {
        switchRescuerDue = false
    }
    
    init(
        config: CPRProtocolConfig = CPRProtocolConfig(
            patientGroup: .adult,
            rescuerMode: .twoOrMore
        )
    ) {

        self.cprCoach = CPRCoach(
            config: config
        )

        self.compressionCycleTarget =
            config.compressionsPerCycle

        self.breathTarget =
            config.breathsPerCycle
    }
    
    func startMotionUpdates() {

        guard motionManager.isDeviceMotionAvailable else {
            errorMessage =
                "Device motion is not available on this device."
            return
        }

        guard !isRunning else {
            return
        }

        errorMessage = nil

        firstTimestamp = nil

        zFilter.reset()
        compressionDetector.reset()
        
        rateEstimator.reset()
        currentCPM = nil
        sessionCompressionTimes.removeAll()
        sessionAverageCPM = nil
        
        rotationMagnitude = 0
        maxRotationMagnitude = 0

        motionManager.deviceMotionUpdateInterval =
            1.0 / 50.0

        motionManager.startDeviceMotionUpdates(
            to: .main
        ) { [weak self] motion, error in

            guard let self else {
                return
            }

            if let error {
                self.errorMessage =
                    error.localizedDescription
                return
            }

            guard let motion else {
                return
            }

            if self.firstTimestamp == nil {
                self.firstTimestamp =
                    motion.timestamp
            }

            guard let firstTimestamp =
                    self.firstTimestamp else {
                return
            }

            let relativeTime =
                motion.timestamp - firstTimestamp

            // userAcceleration already has gravity
            // separated by CoreMotion.
            let x = motion.userAcceleration.x
            let y = motion.userAcceleration.y
            let z = motion.userAcceleration.z
            
            let rotationX = motion.rotationRate.x
            let rotationY = motion.rotationRate.y
            let rotationZ = motion.rotationRate.z

            let rotationMagnitude = sqrt(
                (rotationX * rotationX) +
                (rotationY * rotationY) +
                (rotationZ * rotationZ)
            )

            self.rotationMagnitude = rotationMagnitude

            self.maxRotationMagnitude = max(
                self.maxRotationMagnitude,
                rotationMagnitude
            )
            
            let smoothedZ =
                self.zFilter.add(z)

            self.accelerationX = x
            self.accelerationY = y
            self.accelerationZ = z

            self.filteredZ = smoothedZ
            self.timestamp = relativeTime

            let sample = MotionSample(
                time: relativeTime,
                x: x,
                y: y,
                z: z,
                filteredZ: smoothedZ
            )

            self.samples.append(sample)

            if self.samples.count >
                self.maximumSamples {

                let extra =
                    self.samples.count -
                    self.maximumSamples

                self.samples.removeFirst(extra)
            }

            // Send the filtered motion signal
            // into the compression detector.
            let lateralAcceleration = sqrt(
                (x * x) +
                (y * y)
            )

            let zDominates =
                abs(smoothedZ) >
                lateralAcceleration * 1.25

            // Ignore the first second after the motion sensor starts.
            // This prevents tapping Start / settling the phone
            // from being counted as a compression.
            guard relativeTime >= detectorWarmupTime else {
                return
            }

            if zDominates ||
                compressionDetector.state == .aboveThreshold {

                let detected =
                    self.compressionDetector.process(
                        value: smoothedZ,
                        timestamp: relativeTime
                    )

                if detected {

                    self.compressionCount += 1

                    self.sessionCompressionTimes.append(
                        relativeTime
                    )

                    self.sessionAverageCPM =
                        self.calculateSessionAverageCPM()

                    self.currentCPM =
                        self.rateEstimator.addCompression(
                            at: relativeTime
                        )

                    let coachEvent =
                        self.cprCoach.recordCompression()

                    self.compressionsInCycle =
                        self.cprCoach.compressionsInCycle

                    self.completedCycles =
                        self.cprCoach.completedCycles

                    self.breathsDue =
                        self.cprCoach.breathsDue

                    if case .breathsDue(let breaths) =
                        coachEvent {

                        self.breathTarget = breaths
                    }
                }
            }
            self.currentCPM =
                self.rateEstimator.currentRate(
                    at: relativeTime
                )
            let timeEvent =
                self.cprCoach.updateTime(
                    relativeTime
                )

            if case .switchRescuer = timeEvent {

                self.switchRescuerDue = true
            }
        }

        isRunning = true
    }

    func stopMotionUpdates() {

        motionManager
            .stopDeviceMotionUpdates()

        isRunning = false
        
        cprCoach.reset()

        compressionsInCycle = 0
        completedCycles = 0

        breathsDue = false
        switchRescuerDue = false
    }

    func resetSession() {

        stopMotionUpdates()

        samples.removeAll()

        accelerationX = 0
        accelerationY = 0
        accelerationZ = 0

        filteredZ = 0
        timestamp = 0

        compressionCount = 0

        currentCPM = nil
        rateEstimator.reset()
        sessionCompressionTimes.removeAll()
        sessionAverageCPM = nil

        firstTimestamp = nil

        zFilter.reset()
        compressionDetector.reset()

        rotationMagnitude = 0
        maxRotationMagnitude = 0

        errorMessage = nil
        
        cprCoach.reset()

        compressionsInCycle = 0
        completedCycles = 0

        breathsDue = false

        switchRescuerDue = false
    }

    func clearSamples() {

        samples.removeAll()

        accelerationX = 0
        accelerationY = 0
        accelerationZ = 0

        filteredZ = 0

        timestamp = 0

        firstTimestamp = nil

        zFilter.reset()
    }
    
    private func calculateSessionAverageCPM() -> Double? {

        guard sessionCompressionTimes.count >= 2 else {
            return nil
        }

        var intervals: [TimeInterval] = []

        for index in 1..<sessionCompressionTimes.count {

            let interval =
                sessionCompressionTimes[index] -
                sessionCompressionTimes[index - 1]

            /*
             Ignore long pauses such as the
             ventilation period.

             We want compression pace, not
             compression + breath-pause pace.
             */
            if interval > 0 &&
                interval < 2.0 {

                intervals.append(interval)
            }
        }

        guard !intervals.isEmpty else {
            return nil
        }

        let total =
            intervals.reduce(0, +)

        let averageInterval =
            total / Double(intervals.count)

        return 60.0 / averageInterval
    }

    func exportCSV(
        label: String
    ) throws -> URL {

        let safeLabel = label
            .trimmingCharacters(
                in: .whitespacesAndNewlines
            )
            .replacingOccurrences(
                of: " ",
                with: "_"
            )

        let finalLabel =
            safeLabel.isEmpty
            ? "motion"
            : safeLabel

        let documentsDirectory =
            FileManager.default.urls(
                for: .documentDirectory,
                in: .userDomainMask
            )[0]

        let formatter = DateFormatter()

        formatter.dateFormat =
            "yyyy-MM-dd_HH-mm-ss"

        let dateString =
            formatter.string(from: Date())

        let filename =
            "\(finalLabel)_\(dateString).csv"

        let fileURL =
            documentsDirectory
                .appendingPathComponent(
                    filename
                )

        var csv =
            "time_seconds,x,y,z,filtered_z\n"

        for sample in samples {

            csv += String(
                format:
                    "%.4f,%.6f,%.6f,%.6f,%.6f\n",
                sample.time,
                sample.x,
                sample.y,
                sample.z,
                sample.filteredZ
            )
        }

        try csv.write(
            to: fileURL,
            atomically: true,
            encoding: .utf8
        )

        return fileURL
    }
}
